# Repositório público: apenas a homepage e suas ferramentas de publicação.
# Arquivos ignorados continuam no disco. Isso não remove arquivos do histórico Git.
/*
!/.gitignore
!/README.md
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml
!/scripts/
/scripts/*
!/scripts/build-release.py
!/scripts/update-galleries.py
!/scripts/public_policy.py
!/scripts/check-public.py
!/versoes/
/versoes/*
!/versoes/evolucao/
/versoes/evolucao/*
!/versoes/evolucao/*.html
!/versoes/evolucao/*.css
!/versoes/evolucao/*.js
!/versoes/evolucao/assets/
/versoes/evolucao/assets/**
!/versoes/evolucao/assets/**/
!/versoes/evolucao/assets/**/*.png
!/versoes/evolucao/assets/**/*.webp
!/versoes/evolucao/assets/**/*.avif
!/versoes/evolucao/assets/**/*.svg
!/versoes/evolucao/assets/fonts/*.woff2
!/versoes/evolucao/assets/fonts/OFL.txt
!/versoes/evolucao/assets/fonts/OFL-*.txt
!/versoes/evolucao/assets/fonts/OFL_*.txt

# Originais recebidos, instruções e arquivos ocultos não são a mídia final.
/versoes/evolucao/assets/**/[Ww][Hh][Aa][Tt][Ss][Aa][Pp][Pp]*
/versoes/evolucao/assets/**/[Rr][Ee][Aa][Dd][Mm][Ee]*
/versoes/evolucao/assets/**/[Oo][Rr][Ii][Gg][Ii][Nn][Aa][Ll]*/
/versoes/evolucao/assets/**/[Oo][Rr][Ii][Gg][Ii][Nn][Aa][Ii][Ss]*/
/versoes/evolucao/assets/**/[Rr][Aa][Ww]/
/versoes/evolucao/assets/**/[Pp][Rr][Ii][Vv][Aa][Tt][Ee]/
/versoes/evolucao/assets/**/[Pp][Rr][Ii][Vv][Aa][Dd][Oo]/
/versoes/evolucao/assets/**/*[Oo][Rr][Ii][Gg][Ii][Nn][Aa][Ll]*
/versoes/evolucao/assets/**/*[Oo][Rr][Ii][Gg][Ii][Nn][Aa][Ii][Ss]*
!/versoes/evolucao/assets/hero-carro-original.png
/versoes/evolucao/assets/**/.*
/versoes/evolucao/.*

# Proteção adicional para credenciais, cópias e temporários em caminhos liberados.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*~
**/*.tmp
**/__pycache__/
**/*.pyc
**/.DS_Store
